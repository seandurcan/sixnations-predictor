      expect(fetchMock).toHaveBeenCalledWith(
        "/api/register",
        expect.objectContaining({
          method: "POST",
          body: JSON.stringify({
            ...VALID_FORM,
            firstName: "SeÃ¡n-John",
            lastName: "O'Connor-Smith",
          }),
